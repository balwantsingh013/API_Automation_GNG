<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{dd-MM-yyyy HH:mm:ss} %5p [%t] (%F:%L) - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Enable DEBUG level for JdbcTemplate to log SQL queries -->
        <Logger name="org.springframework.jdbc.core.JdbcTemplate" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Enable TRACE level for StatementCreatorUtils to log SQL parameters -->
        <Logger name="org.springframework.jdbc.core.StatementCreatorUtils" level="trace" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Root logger -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
